.page {
  min-height: 100%;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hello {
  font-size: 34rpx;
  font-weight: 700;
}

.quiet {
  color: #8e8e93;
  font-size: 26rpx;
}

.empty {
  margin-top: 80rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
}

.row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 24rpx;
}

.mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.copy {
  min-width: 0;
  flex: 1;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
}

.preview {
  display: block;
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.create {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 30rpx;
}
