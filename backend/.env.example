# 留空则使用 Python 自带的 SQLite，文件在 data/harness.sqlite。
# 写成 MySQL 连接串后，若启动时连不上，也会自动改用 SQLite。
DATABASE_URL=
# DATABASE_URL=mysql+pymysql://harness:harness_local@127.0.0.1:3306/harness?charset=utf8mb4
DEEPSEEK_API_KEY=
# 留空时，设置里的密钥用 data/secret.key 加密。换机器或备份数据库时要一起带走这把钥匙。
# HARNESS_SECRET_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
HARNESS_WORKSPACE=
AUTO_SEED=false
ENABLE_SCHEDULER=true
