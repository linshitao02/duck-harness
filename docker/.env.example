# 复制成 docker/.env 后再填写。这个文件不要提交。
# 留空则使用容器里的 SQLite，数据在卷 duck-data 中。
DATABASE_URL=
DEEPSEEK_API_KEY=
# 留空时，设置里的密钥用数据卷里的 /data/secret.key 加密。
# HARNESS_SECRET_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
AUTO_SEED=true
ENABLE_SCHEDULER=true

# 要让 Agent 改服务器上的某个目录时，写成该目录的绝对路径。
# 留空则使用 Docker 卷 duck-workspace。目录需要对 uid 1000 可写。
HARNESS_WORKSPACE_HOST=
