.page {
  min-height: 100%;
  padding: 72rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #ff4b93;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
}

.label {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #636366;
  font-size: 24rpx;
}

.field {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f4f4f5;
  font-size: 30rpx;
}

.error {
  display: block;
  margin-top: 18rpx;
  color: #e23b3b;
  font-size: 26rpx;
}

.go {
  margin-top: 36rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 30rpx;
}

.hint {
  display: block;
  margin-top: 28rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.6;
}
